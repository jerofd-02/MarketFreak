{
  "form": {
    "fields": {
      "product_name": {
        "label": "Nombre del producto",
        "placeholder": "Escriba el nombre del producto...",
        "type": "text",
        "validation": {
          "required": true,
          "minLength": 3
        }
      },
      "price": {
        "label": "Precio",
        "placeholder": "Introduzca el precio del producto...",
        "type": "number",
        "step": "0.01",
        "validation": {
          "required": true,
          "min": 0
        }
      },
      "category": {
        "label": "Categoría del producto",
        "type": "select",
        "validation": {
          "required": true
        },
        "options": [
          { "value": "", "label": "Selecciona una categoría", "disabled": true },
          { "value": "figures", "label": "Figuras y estatuillas" },
          { "value": "coins", "label": "Monedas y billetes" },
          { "value": "stamps", "label": "Sellos y postales" },
          { "value": "comics", "label": "Cómics y libros" },
          { "value": "cards", "label": "Cartas coleccionables" },
          { "value": "others", "label": "Otros" }
        ]
      },
      "description": {
        "label": "Descripción",
        "placeholder": "Introduzca una descripción para el producto...",
        "type": "textarea",
        "validation": {
          "required": true,
          "minLength": 10
        }
      },
      "image": {
        "placeholder": "Arrastra tu(s) foto(s) aquí o haz clic para seleccionar",
        "type": "file",
        "maxImages": 5,
        "validation": {
          "required": true
        }
      }
    },
    "submitButton": "Enviar consulta"
  }
}
